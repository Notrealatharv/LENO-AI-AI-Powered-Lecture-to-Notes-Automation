    {
      "parameters": {
        "resource": "video",
        "operation": "analyze",
        "modelId": {
          "__rl": true,
          "mode": "list",
          "value": "models/gemini-2.5-flash",
          "cachedResultName": "Gemini 2.5 Flash"
        },
        "text": "You are LENO-AI, an expert lecture-to-notes study assistant. Analyze the provided YouTube lecture and create accurate study notes based on the accessible video content. Do not invent details.\n\nFormat the response for Telegram using plain text:\nTITLE: <short title>\nSUMMARY: 2-4 sentences\nKEY CONCEPTS: bullets beginning with •\nDETAILED NOTES: short UPPERCASE subheadings and bullets\nIMPORTANT TERMS: term and definition\nQUICK REVISION: 5 exam-style questions with answers\n\nIf the video cannot be accessed or its content is unavailable, clearly say so.",
        "videoUrls": "={{ $json.youtubeUrl }}",
        "options": {
          "maxOutputTokens": 8192
        }
      },
      "id": "70b19f7a-a563-4cbb-a3a4-34015a13cf01",
