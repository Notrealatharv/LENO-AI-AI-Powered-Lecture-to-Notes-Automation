      "id": "a165aaec-76b2-4546-a602-67a9b66246ac",
      "name": "Extract PDF Text",
      "type": "n8n-nodes-base.extractFromFile",
      "typeVersion": 1.2,
      "position": [
        1024,
        128
      ]
    },
    {
      "parameters": {
        "modelId": {
          "__rl": true,
          "mode": "list",
          "value": "models/gemini-2.5-flash",
          "cachedResultName": "Gemini 2.5 Flash"
        },
        "messages": {
          "values": [
            {
              "content": "=Source type: PDF document\n\nSOURCE:\n{{ ($json.text || \"\").slice(0, 400000) }}"
            }
          ]
        },
        "builtInTools": {},
        "options": {
          "systemMessage": "You are LENO-AI, an expert study assistant. Turn the supplied PDF text into clear, well-structured study notes. Use plain text suitable for Telegram.\nStart with TITLE: <short title>, then SUMMARY (2-4 sentences), KEY CONCEPTS with • bullets, DETAILED NOTES with uppercase subheadings and bullets, IMPORTANT TERMS as • Term: definition, and QUICK REVISION with 5 questions and answers. Be accurate and use only information in the source.",
          "maxOutputTokens": 8192,
          "temperature": 0.3
        }
      },
      "id": "065c0ff3-5347-4c20-a029-c9a084f81864",
      "name": "Notes from PDF",
      "type": "@n8n/n8n-nodes-langchain.googleGemini",
      "typeVersion": 1.2,
      "position": [
        1248,
        128
      ]
    },
    {
      "parameters": {
        "jsCode": "const j = $input.first().json;\nlet notes = '';\nif (j.content && Array.isArray(j.content.parts)) {\n  notes = j.content.parts.map(p => p.text || '').join('');\n} else if (Array.isArray(j.candidates) && j.candidates[0] && j.candidates[0].content) {\n  notes = (j.candidates[0].content.parts || []).map(p => p.text || '').join('');\n} else if (typeof j.text === 'string') {\n  notes = j.text;\n} else if (typeof j.content === 'string') {\n  notes = j.content;\n}\nnotes = (notes || '').replace(/\\*\\*/g, '').replace(/^#+\\s*/gm, '').trim();\nif (!notes) notes = 'Sorry, I could not generate notes from this source. Please try again or send a different source.';\n\nconst MAX = 3900;\nconst chunks = [];\nlet current = '';\nfor (const para of notes.split('\\n')) {\n  let line = para;\n  while (line.length > MAX) {\n    if (current) { chunks.push(current); current = ''; }\n    chunks.push(line.slice(0, MAX));\n    line = line.slice(MAX);\n  }\n  if ((current + '\\n' + line).length > MAX) {\n    chunks.push(current);\n    current = line;\n  } else {\n    current = current ? current + '\\n' + line : line;\n  }\n}\nif (current) chunks.push(current);\n\nconst esc = s => s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');\nreturn chunks.map((c, i) => ({ json: { message: esc(c) + (chunks.length > 1 ? '\\n\\n(' + (i + 1) + '/' + chunks.length + ')' : '') } }));"
      },
      "id": "433a08ce-7f6b-4a61-808f-63b1f59a2b68",
      "name": "Split Notes into Messages",
